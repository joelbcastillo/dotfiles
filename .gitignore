# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# User-specific files
*.log
*.swp
*.swo
*~

# Backup files
*.bak
*.backup
*.old

# Temporary files
tmp/
temp/

# Private configuration files (users should create their own)
config.json

# Private files (managed by dotfiles-private repository)
# The pre-commit hook automatically ignores any symlinks pointing to the private repo

# Personal configurations (symlinked from private repo)
.dotbot/configs/ssh-*.yaml
.dotbot/configs/claude-tools-private.yaml

# AI tools personal configurations
tools/claude/config.json
tools/cursor-agent/config.json
tools/1password/secret-paths.json

# 1Password config (contains device/account IDs - should be per-user).
# Scripts (.sh) and templates (.template) are shared; instance-specific
# JSON/config files stay local.
tools/1password/accounts.json
tools/1password/config
tools/1password/secret-paths.json

# Claude AI configuration (personal settings)
.claude/settings.local.json
.claude/dmux/
.claude/hooks/

# Backup location files
.backup_location

# Git directory - ignore everything except specific files
tools/git/*
!tools/git/gitconfig
!tools/git/gitconfig.user.template
!tools/git/gitignore_global
!tools/git/gitmessage
!tools/git/headless-signing-config.sh
!tools/git/lazygit.yaml
# Per-identity gitconfigs are symlinks into ~/.dotfiles-private/git/; tracked
# with relative targets so the symlink itself documents the wiring.
!tools/git/gitconfig.personal

# Zsh before directory - ignore everything except allowed files
shells/zsh/zsh.before/*
!shells/zsh/zsh.before/1password.zsh
!shells/zsh/zsh.before/asdf.zsh
!shells/zsh/zsh.before/claude-tools.zsh
!shells/zsh/zsh.before/completion.zsh
!shells/zsh/zsh.before/direnv.zsh
!shells/zsh/zsh.before/history.zsh
!shells/zsh/zsh.before/key-bindings.zsh
!shells/zsh/zsh.before/noglob.zsh
!shells/zsh/zsh.before/path.zsh
!shells/zsh/zsh.before/rm.zsh
!shells/zsh/zsh.before/zmv.zsh
!shells/zsh/zsh.before/zoxide.zsh
# Aliases/company-aliases are symlinks into ~/.dotfiles-private/aliases/.
!shells/zsh/zsh.before/aliases.zsh
!shells/zsh/zsh.before/company-aliases.zsh
!shells/zsh/zsh.before/aliases.zsh.template

# Template files (these are the public versions)
!apps/vscode/settings.json.template
!apps/cursor/settings.json.template
!.claude/settings.local.json.template
!tools/claude/config.json.template
!tools/cursor-agent/config.json.template
!tools/1password/secret-paths.json.template
!tools/finicky/finicky.js.template

# SSH - Ignore everything except templates and docs
tools/ssh/config
tools/ssh/configs/
tools/ssh/keys/**/*
!tools/ssh/keys/**/.gitkeep
!tools/ssh/**/*.template
!tools/ssh/**/*.md

# Claude tools - Ignore actual configs (symlinked from private repo), allow templates
tools/claude-tools/dmux.conf.yaml

# Finicky - Ignore actual config (symlinked from private repo), allow template
tools/finicky/finicky.js

# Application-specific configs
tools/aws/*/credentials
apps/vscode/*-settings.json.context/
.dotfiles.code-workspace
.dmux/

# (Previously gitignored: symlinks materialized at install time by
# scripts/setup-private-files.sh. The script now writes RELATIVE
# symlink targets via perl File::Spec, so they're portable across
# machines and idempotent against committed values. The files are
# tracked again — see git history for the un-gitignore commit.)
