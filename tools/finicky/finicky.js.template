/**
 * Finicky Configuration Template
 *
 * Routes URLs to appropriate browsers based on source application and URL patterns.
 *
 * Primary use case: Open links from Microsoft Teams and Outlook in Microsoft Edge
 * with the domain account profile.
 *
 * IMPORTANT: This configuration requires the EdgeProfile app to be installed.
 * See docs/finicky.md for installation instructions.
 *
 * API Note: This configuration uses the Finicky v4 API where:
 * - The first argument to match/browser functions is the URL instance
 * - The second argument contains context (sourceBundleIdentifier, opener, etc.)
 * - See: https://github.com/johnste/finicky/discussions/378
 */

module.exports = {
  // Default browser for all other links
  defaultBrowser: "Safari",

  handlers: [
    {
      // Match URLs from Microsoft Teams and Outlook
      // This includes Office 365, SharePoint, and other Microsoft services
      // Finicky v4 API: url is first arg, context is second arg
      match: (url, { sourceBundleIdentifier }) => {
        // Check if the link is coming from Microsoft Teams or Outlook
        const isFromMicrosoftApp =
          sourceBundleIdentifier === "com.microsoft.teams" ||
          sourceBundleIdentifier === "com.microsoft.Outlook" ||
          sourceBundleIdentifier === "com.microsoft.Office365ServiceV2";

        // URL is a URL instance in Finicky v4
        const urlString = url instanceof URL ? url.href : String(url);

        // Match Microsoft Office URLs (including Safe Links)
        const isMicrosoftUrl =
          /^https?:\/\/(teams\.microsoft\.com|outlook\.(office|live)\.com|.*\.sharepoint\.com|.*\.office\.com|.*\.office365\.com|.*\.microsoft\.com|.*\.teams\.cdn\.office\.net|.*\.safelinks\.protection\.outlook\.com)/.test(urlString);

        return isFromMicrosoftApp || isMicrosoftUrl;
      },
      // Use EdgeProfile app which properly handles open -na for profile support
      // This works around macOS ignoring --profile-directory when Edge is already running
      browser: "EdgeProfile",
    },
    {
      // Additional handler for Microsoft URLs even if not from Teams/Outlook
      // This catches direct clicks on Microsoft links
      match: [
        "https://teams.microsoft.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://*.sharepoint.com/*",
        "https://*.office.com/*",
        "https://*.office365.com/*",
        "https://*.microsoft.com/*",
        "https://*.teams.cdn.office.net/*",
        "https://*.safelinks.protection.outlook.com/*",
      ],
      // Use EdgeProfile app which properly handles open -na for profile support
      browser: "EdgeProfile",
    },
  ],

  // Optional: Log all URL routing decisions for debugging
  // options: {
  //   logRequests: true
  // }
};
