# Brewfile for Linux (Linuxbrew).
#
# NOTE: The default Linux bootstrap (scripts/bootstrap-linux.sh) installs
# these tools via apt + direct installers, not Linuxbrew. This file is
# here as a reference list (per user request: "store everything") and is
# only consumed if the user opts into Linuxbrew at /home/linuxbrew/.linuxbrew.
#
# Casks and `mas` entries are excluded: they are macOS-only.

tap "hashicorp/tap"
tap "schpet/tap"
tap "supabase/tap"
tap "airbytehq/tap"
tap "github/gh"

brew "act"
brew "ansible"
brew "asdf"
brew "awscli"
brew "azure-cli"
brew "bat"
brew "bottom"
brew "cloudflared"
brew "coreutils"
brew "curl"
brew "direnv"
brew "docker-compose"
brew "doctl"
brew "eza"
brew "fd"
brew "ffmpeg"
brew "fzf"
brew "gh"
brew "ghq"
brew "git-lfs"
brew "gnu-sed"
brew "gnu-which"
brew "grep"
brew "hadolint"
brew "helm"
brew "heroku"
brew "htop"
brew "jq"
brew "kubernetes-cli"
brew "lazygit"
brew "libpq", link: true
brew "localtunnel"
brew "mdbtools"
brew "neofetch"
brew "openai-whisper"
brew "pandoc"
brew "pipx"
brew "poppler"
brew "pre-commit"
brew "python@3.13"
brew "qrencode"
brew "ripgrep"
brew "shellcheck"
brew "slackdump"
brew "speedtest-cli"
brew "sshpass"
brew "starship"
brew "supabase"
brew "tldr"
brew "tmux"
brew "tree"
brew "wget"
brew "yt-dlp"
brew "zoxide"
brew "zsh"
brew "airbytehq/tap/abctl"
brew "hashicorp/tap/terraform"
brew "schpet/tap/linear"
