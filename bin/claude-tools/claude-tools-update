#!/bin/sh
# Update the Claude CLIs in one command.
#   claude — native self-updating build in ~/.local/bin (installed via `claude install`)
#   ccs    — @kaitranntt/ccs           (npm-global under the home-pinned asdf node)
#   ccr    — @musistudio/claude-code-router (npm-global under the home-pinned asdf node)
# The npm CLIs run on the home-pinned node so no repo's local node pin interferes.
set -eu

ver="$(awk '$1 == "nodejs" {print $2}' "$HOME/.tool-versions" 2>/dev/null || true)"
bin="$HOME/.asdf/installs/nodejs/$ver/bin"

if [ -z "$ver" ] || [ ! -x "$bin/npm" ]; then
  echo "error: home-pinned node '${ver:-<none>}' isn't installed at $bin" >&2
  echo "       run: asdf install nodejs ${ver:-<version>}" >&2
  exit 1
fi

echo "Updating ccs + ccr (npm, node $ver) ..."
"$bin/npm" install -g @kaitranntt/ccs @musistudio/claude-code-router

echo
claude_bin="$HOME/.local/bin/claude"
if [ -x "$claude_bin" ]; then
  echo "Updating claude (native build) ..."
  "$claude_bin" install stable
else
  echo "note: native claude not at $claude_bin — skipping." \
       "If claude is an npm-global instead, add @anthropic-ai/claude-code above."
fi

echo
echo "Now installed:"
"$bin/npm" ls -g --depth=0 2>/dev/null \
  | grep -E '@kaitranntt/ccs@|claude-code-router@' \
  | sed -E 's/^[^@a-z]*/  /'
[ -x "$claude_bin" ] && printf '  claude   %s\n' "$("$claude_bin" --version 2>/dev/null | head -1)"
