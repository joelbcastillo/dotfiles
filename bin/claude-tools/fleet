def serve(port):
    import socket
    import threading
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    # The PR fetch takes ~20s cold. Never block the socket on it: bind first,
    # refresh in the background, and let the page render sessions immediately.
    state = {"prs": [], "at": 0.0, "loading": True, "error": ""}
    lock = threading.Lock()

    def refresh(force=False):
        with lock:
            if state["loading"] and not force:
                return
            state["loading"] = True
        try:
            prs, stamp = fetch_prs(force)
            for p in prs:
                p["shippable"] = shippable(p)
            with lock:
                state.update(prs=prs, at=stamp, error="")
        except Exception as exc:                      # a failed fetch must not kill the page
            with lock:
                state["error"] = f"{type(exc).__name__}: {exc}"
        finally:
            with lock:
                state["loading"] = False

    def poller():
        while True:
            refresh(force=True)
            time.sleep(CACHE_TTL)

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *a):
            pass

        def do_GET(self):
            if self.path.startswith("/api"):
                sessions = load_sessions()
                rows = build_rows(sessions, load_feed(), load_intents(sessions))
                with lock:
                    snapshot = dict(state)
                body = json.dumps({"sessions": rows,
                                   "prs": snapshot["prs"],
                                   "pr_checked_at": snapshot["at"],
                                   "pr_loading": snapshot["loading"],
                                   "pr_error": snapshot["error"]})
                ctype = "application/json"
            else:
                body = PAGE
                ctype = "text/html; charset=utf-8"
            raw = body.encode()
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)

    try:
        httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError as exc:
        if exc.errno in (48, 98):  # EADDRINUSE
            print(f"port {port} is already in use — another `fleet --serve` is probably running.",
                  file=sys.stderr)
            print(f"  check:  lsof -nP -iTCP:{port} -sTCP:LISTEN", file=sys.stderr)
            print(f"  or:     fleet --serve --port {port + 1}", file=sys.stderr)
        else:
            print(f"could not bind 127.0.0.1:{port} — {exc}", file=sys.stderr)
        sys.exit(1)

    # Only now is the URL actually reachable.
    print(f"fleet -> http://127.0.0.1:{port}   (ctrl-c to stop)", flush=True)
    print("  sessions render immediately; PRs fill in once the first fetch lands (~20s)", flush=True)
    threading.Thread(target=poller, daemon=True).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped", flush=True)
        httpd.server_close()


def main():
    ap = argparse.ArgumentParser(description="One screen for your Claude session fleet.")
    ap.add_argument("--all", action="store_true", help="show every session and PR")
    ap.add_argument("--refresh", action="store_true", help="bypass the PR cache")
    ap.add_argument("--limit", type=int, default=12, help="sessions to show (default 12)")
    ap.add_argument("--sessions", action="store_true", help="sessions only (instant, no network)")
    ap.add_argument("--prs", action="store_true", help="PRs only")
    ap.add_argument("--repo", help="filter both halves to repos matching this substring")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--serve", action="store_true", help="serve a live auto-refreshing page")
    ap.add_argument("--port", type=int, default=8777, help="port for --serve (default 8777)")
    a = ap.parse_args()

    if a.serve:
        serve(a.port)
        return

    want_s = not a.prs
    want_p = not a.sessions

    rows = []
    if want_s:
        sessions = load_sessions()
        rows = build_rows(sessions, load_feed(), load_intents(sessions))
    prs, stamp = fetch_prs(a.refresh) if want_p else ([], time.time())

    if a.repo:
        needle = a.repo.lower()
        rows = [r for r in rows if needle in r["repo"].lower()]
        prs = [p for p in prs if needle in p["repo"].lower()]

    if a.json:
        json.dump({"sessions": rows, "prs": prs, "pr_checked_at": stamp}, sys.stdout, indent=2)
        print()
        return

    live = sum(1 for r in rows if r["life"] in ("running", "needsInput"))
    head = []
    if want_s:
        head.append(f"{len(rows)} sessions" + (f" ({live} live)" if live else ""))
    if want_p:
        head.append(f"{len(prs)} open PRs")
    print(c("bold", "FLEET") + c("dim", "  ·  " + "  ·  ".join(head)))

    if want_s:
        render_sessions(rows, a.limit, a.all)
    if want_p:
        render_prs(prs, stamp, a.all)
    print()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
