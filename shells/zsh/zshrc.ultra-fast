# Ultra-fast zshrc configuration
# Optimized for minimal startup time while maintaining functionality

# Essential environment variables
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Fix for shell integrations that expect dump_zsh_state function
dump_zsh_state() {
    # Dummy function to prevent "command not found" errors
    # This is used by some shell integrations for debugging
    return 0
}

# Set DOTFILES variable
export DOTFILES="$HOME/.dotfiles"

# Enhanced PATH
export PATH="$HOME/.local/bin:$PATH"
export PATH="$DOTFILES/scripts:$PATH"
export PATH="$PATH:$HOME/.oh-my-zsh/custom/scripts"

# Editor configuration
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='cursor --wait'
fi
export VISUAL="$EDITOR"

# Fast completion system
autoload -Uz compinit
# Only run compinit once per day for speed
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

# Case insensitive path-completion
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*'

# Partial completion suggestions
zstyle ':completion:*' list-suffixes
zstyle ':completion:*' expand prefix suffix

# Menu selection
zstyle ':completion:*' menu select

# Cache completion to speed up load time
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ${ZSH_CACHE_DIR:-$HOME/.cache/zsh}

# History configuration
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history

# Append to history file instead of overwriting
setopt APPEND_HISTORY

# Add commands as they are typed, not at shell exit
setopt INC_APPEND_HISTORY

# Key bindings
bindkey -v
bindkey '^r' history-incremental-search-backward

# Essential aliases
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'

# Git aliases
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline'
alias gd='git diff'
alias g='git'
alias gaa='git add --all'
alias gapa='git add --patch'
alias gau='git add --update'
alias gav='git add --verbose'
alias grt='cd "$(git rev-parse --show-toplevel || echo .)"'
alias gwip='git add -A; git rm $(git ls-files --deleted) 2> /dev/null; git commit --no-verify --no-gpg-sign --message "--wip-- [skip ci]"'
alias gam='git am'

# Brew aliases
alias ba='brew autoremove'
alias bcfg='brew config'
alias bci='brew info --cask'
alias bcin='brew install --cask'
alias bcl='brew list --cask'
alias bcn='brew cleanup'
alias bco='brew outdated --cask'
alias bcrin='brew reinstall --cask'
alias bcubc='brew upgrade --cask && brew cleanup'
alias bcubo='brew update && brew outdated --cask'

# Advanced system aliases
alias git='noglob git'
alias rm='nocorrect rm'

# Zoxide aliases
alias cdi="zi"

# 1Password SSH Agent Configuration
export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock

# Fig shell integration (minimal)
[ -s ~/.fig/shell/pre.sh ] && source ~/.fig/shell/pre.sh

# Amazon Q integration (minimal)
[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh"

# Starship (if available) - lazy loaded
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# Lazy load heavy components
# ASDF (0.16+; see zsh.before/asdf.zsh)
asdf() {
    unfunction asdf
    if [[ -f "$DOTFILES/shells/zsh/zsh.before/asdf.zsh" ]]; then
        # shellcheck disable=SC1090
        source "$DOTFILES/shells/zsh/zsh.before/asdf.zsh"
    fi
    command asdf "$@"
}

# Direnv
direnv() {
    unfunction direnv
    eval "$(direnv hook zsh)"
    direnv "$@"
}

# Zoxide
z() {
    unfunction z
    eval "$(zoxide init zsh)"
    z "$@"
}

# Oh My Zsh features - lazy loaded for performance
load_oh_my_zsh_features() {
    # Git plugin features
    if [ -f "$HOME/.oh-my-zsh/plugins/git/git.plugin.zsh" ]; then
        source "$HOME/.oh-my-zsh/plugins/git/git.plugin.zsh"
    fi

    # Brew plugin features
    if [ -f "$HOME/.oh-my-zsh/plugins/brew/brew.plugin.zsh" ]; then
        source "$HOME/.oh-my-zsh/plugins/brew/brew.plugin.zsh"
    fi

    # Zsh autosuggestions
    if [ -f "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
        source "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
    fi

    # Zsh syntax highlighting
    if [ -f "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
        source "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
    fi

    # Custom functions
    if [ -f "$DOTFILES/shells/oh-my-zsh/custom/functions.zsh" ]; then
        source "$DOTFILES/shells/oh-my-zsh/custom/functions.zsh"
    fi

    # Remove the hook after loading
    add-zsh-hook -d precmd load_oh_my_zsh_features
}

# Set up lazy loading for Oh My Zsh features
autoload -Uz add-zsh-hook
add-zsh-hook precmd load_oh_my_zsh_features

# Task Master aliases
alias tm='task-master'
alias taskmaster='task-master'

# Amazon Q post block
[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh"

# Fig shell integration (end)
[ -s ~/.fig/fig.sh ] && source ~/.fig/fig.sh
