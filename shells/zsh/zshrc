# Optimized zshrc with lazy loading for heavy components
# Maintains all functionality while improving startup performance

# --- Core / env ---
# Fix for shell integrations that expect dump_zsh_state function
dump_zsh_state() {
    # Dummy function to prevent "command not found" errors
    return 0
}

export DOTFILES="$HOME/.dotfiles"
export ZSH="$HOME/.oh-my-zsh"

# Plugin configuration
plugins=(
    git
    brew
    zsh-autosuggestions
    zsh-syntax-highlighting
)
export ZSH_DISABLE_COMPFIX="true"

# Disable OMZ's auto-update check at shell init. It's run inline (blocks
# new shells) and on stale caches it shells out to git/network, which on
# the headless box was contributing seconds of wall-clock delay. Run
# `omz update` manually when needed.
DISABLE_AUTO_UPDATE="true"
DISABLE_UPDATE_PROMPT="true"
zstyle ':omz:update' mode disabled

# Editor configuration
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='cursor --wait'
fi
export VISUAL="$EDITOR"

# 1Password SSH Agent Configuration.
# Guard for headless / GUI-less hosts where the 1Password app isn't running:
# pointing SSH_AUTH_SOCK at a nonexistent socket makes ssh-add / git fall over
# with confusing "communication with agent failed" errors. Only export when
# the socket actually exists.
_op_ssh_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
if [[ -S "$_op_ssh_sock" ]]; then
  export SSH_AUTH_SOCK="$_op_ssh_sock"
fi
unset _op_ssh_sock

# --- OMZ & prompt ---
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source $ZSH/oh-my-zsh.sh
fi

if [[ -f "$DOTFILES/shells/oh-my-zsh/custom/functions.zsh" ]]; then
    source "$DOTFILES/shells/oh-my-zsh/custom/functions.zsh"
fi

if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# --- Source zsh.before / zsh.after ---
for file in ~/.zsh.before/*.zsh; do
    case "$(basename "$file")" in
        zoxide.zsh|direnv.zsh|completion.zsh)
            continue
            ;;
    esac
    [[ -f "$file" ]] && source "$file"
done

setopt nullglob
for file in ~/.zsh.after/*.zsh; do
    [[ -f "$file" ]] && source "$file"
done
unsetopt nullglob

# --- asdf 0.16+ ---
# The shims / bin/claude-tools PATH entries are set in shells/zsh/zshenv so that
# non-interactive shells get the pinned toolchain too. Reassert here because the
# zsh.before/*.zsh loop above runs after zshenv, and path.zsh prepends
# /opt/homebrew/{bin,sbin} — which would otherwise put Homebrew's node ahead of
# the shim in exactly the interactive shells you notice it least.
(( $+functions[_pin_toolchain_path] )) && _pin_toolchain_path

# --- Lazy load ---
asdf() {
    unfunction asdf
    fpath=("${ASDF_DATA_DIR:-$HOME/.asdf}/completions" $fpath)
    autoload -Uz compinit && compinit -C
    command asdf "$@"
}

direnv() {
    unfunction direnv
    eval "$(direnv hook zsh)"
    direnv "$@"
}

(( $+aliases[z] )) && unalias z
z() {
    unfunction z 2>/dev/null
    eval "$(zoxide init zsh)"
    z "$@"
}

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# 1Password service account token (headless profile)
[[ -f ~/.config/op/token.sh ]] && source ~/.config/op/token.sh
