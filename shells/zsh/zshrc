# Optimized zshrc with lazy loading for heavy components
# Maintains all functionality while improving startup performance

# Enable Powerlevel10k instant prompt
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Fig shell integration
[ -s ~/.fig/shell/pre.sh ] && source ~/.fig/shell/pre.sh

# Fix for shell integrations that expect dump_zsh_state function
dump_zsh_state() {
    # Dummy function to prevent "command not found" errors
    # This is used by some shell integrations for debugging
    return 0
}

# Set DOTFILES variable
export DOTFILES="$HOME/.dotfiles"

# Path to your oh-my-zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Theme configuration
ZSH_THEME="steeef"

# Plugin configuration
plugins=(
    git
    brew
    zsh-autosuggestions
    zsh-syntax-highlighting
)

# Disable compinit errors for group owned directories
export ZSH_DISABLE_COMPFIX="true"

# Editor configuration
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='cursor --wait'
fi
export VISUAL="$EDITOR"

# 1Password SSH Agent Configuration
export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock

# Amazon Q integration
[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh"

# Load Oh My Zsh (load immediately, not lazy - needed for prompt)
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source $ZSH/oh-my-zsh.sh
fi

# Source custom functions
if [ -f "$DOTFILES/shells/oh-my-zsh/custom/functions.zsh" ]; then
    source "$DOTFILES/shells/oh-my-zsh/custom/functions.zsh"
fi

# Initialize Starship
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# Source all zsh.before files (exclude lazy-loaded ones)
for file in ~/.zsh.before/*.zsh; do
    # Skip files that are lazy loaded
    case "$(basename "$file")" in
        zoxide.zsh|direnv.zsh|completion.zsh)
            continue
            ;;
    esac
    [ -f "$file" ] && source "$file"
done

# Source all zsh.after files
setopt nullglob
for file in ~/.zsh.after/*.zsh; do
    [ -f "$file" ] && source "$file"
done
unsetopt nullglob

# Lazy load ASDF
asdf() {
    unfunction asdf
    . $HOME/.asdf/asdf.sh
    fpath=(${ASDF_DIR}/completions $fpath)
    autoload -Uz compinit && compinit -C
    asdf "$@"
}

# Lazy load Direnv
direnv() {
    unfunction direnv
    eval "$(direnv hook zsh)"
    direnv "$@"
}

# Lazy load Zoxide
# Remove alias if it exists before defining function
(( $+aliases[z] )) && unalias z
z() {
    unfunction z 2>/dev/null
    eval "$(zoxide init zsh)"
    z "$@"
}

# Task Master aliases
alias tm='task-master'
alias taskmaster='task-master'

# Claude Code Authentication - Using Subscription
#
# Both Claude Code and Conductor use subscription authentication by default.
# This means you need to be logged in via 'claude login' for interactive use.
#
# To check authentication status: claude /status
#
# If you need to use API key (pay-as-you-go) for specific tools, you can:
#   export ANTHROPIC_API_KEY="$($DOTFILES/scripts/get-claude-api-key.sh api)"
#
# To unset API key and use subscription: unset ANTHROPIC_API_KEY

# Function to temporarily use API key (if needed for specific tools)
use-api-key() {
    if command -v op >/dev/null 2>&1; then
        export ANTHROPIC_API_KEY="$($DOTFILES/scripts/get-claude-api-key.sh api 2>/dev/null)"
        echo "API key set (pay-as-you-go billing)"
    else
        echo "Error: 1Password CLI not available"
    fi
}

# Function to use subscription (unset API key)
use-subscription() {
    unset ANTHROPIC_API_KEY
    echo "Using subscription authentication"
    claude /status
}

# Alias to check authentication status
alias claude-auth='~/.dotfiles/scripts/check-claude-auth.sh'

# Override any broken claude alias to point to the correct binary
if [ -f /opt/homebrew/bin/claude ]; then
    alias claude='/opt/homebrew/bin/claude'
elif [ -f ~/.local/bin/claude ]; then
    alias claude='~/.local/bin/claude'
fi

# Amazon Q post block
[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh"

# Fig shell integration (end)
[ -s ~/.fig/fig.sh ] && source ~/.fig/fig.sh
