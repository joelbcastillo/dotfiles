# Optimized zshrc with lazy loading for heavy components
# Maintains all functionality while improving startup performance

# --- Core / env ---
# Fix for shell integrations that expect dump_zsh_state function
dump_zsh_state() {
    # Dummy function to prevent "command not found" errors
    return 0
}

export DOTFILES="$HOME/.dotfiles"
export ZSH="$HOME/.oh-my-zsh"

# Plugin configuration
plugins=(
    git
    brew
    zsh-autosuggestions
    zsh-syntax-highlighting
)
export ZSH_DISABLE_COMPFIX="true"

# Editor configuration: vim over SSH; otherwise pick the first available
# local editor in this order. Lets the same zshrc work on Mac (Cursor.app)
# and on a Linux droplet without a GUI editor.
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  for _ed in 'cursor --wait' 'code --wait' 'nvim' 'vim'; do
    if command -v "${_ed%% *}" >/dev/null 2>&1; then
      export EDITOR="$_ed"
      break
    fi
  done
  unset _ed
fi
export VISUAL="$EDITOR"

# 1Password SSH Agent Configuration (per-OS)
if [[ "$OSTYPE" == "darwin"* ]]; then
    export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
elif [[ -S "$HOME/.1password/agent.sock" ]]; then
    export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
fi

# --- OMZ & prompt ---
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source $ZSH/oh-my-zsh.sh
fi

if [[ -f "$DOTFILES/shells/oh-my-zsh/custom/functions.zsh" ]]; then
    source "$DOTFILES/shells/oh-my-zsh/custom/functions.zsh"
fi

if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# --- Source zsh.before / zsh.after ---
for file in ~/.zsh.before/*.zsh; do
    case "$(basename "$file")" in
        zoxide.zsh|direnv.zsh|completion.zsh)
            continue
            ;;
    esac
    [[ -f "$file" ]] && source "$file"
done

setopt nullglob
for file in ~/.zsh.after/*.zsh; do
    [[ -f "$file" ]] && source "$file"
done
unsetopt nullglob

# --- Lazy load (asdf: loaded in zsh.before/asdf.zsh for 0.16+; no duplicate PATH here) ---

direnv() {
    unfunction direnv
    eval "$(direnv hook zsh)"
    direnv "$@"
}

(( $+aliases[z] )) && unalias z
z() {
    unfunction z 2>/dev/null
    eval "$(zoxide init zsh)"
    z "$@"
}
