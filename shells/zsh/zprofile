# Homebrew environment is loaded in zshenv (redundant but ensures it's available)
# This handles the case where zshenv might not have been sourced
# Dynamically detect Homebrew location (user-local, system ARM, or system Intel)
if [[ -x "$HOME/.homebrew/bin/brew" ]]; then
  eval "$($HOME/.homebrew/bin/brew shellenv)"
elif [[ -x "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Reassert the asdf shims / bin/claude-tools ordering. This is a login shell, so
# /etc/zprofile just ran path_helper (reorders PATH) and the brew shellenv above
# prepends Homebrew — both would otherwise leave /opt/homebrew/bin/node ahead of
# the shim and silently ignore the tool-versions pin. Defined in zshenv, which
# runs first in this same shell.
(( $+functions[_pin_toolchain_path] )) && _pin_toolchain_path
