# Set language
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Set dotfiles directory
export DOTFILES="$HOME/.dotfiles"

# Headless / service-account hosts: load OP_SERVICE_ACCOUNT_TOKEN if it has
# been provisioned. Must come BEFORE the GitHub-PAT block below — that block
# uses [ -z "$OP_SERVICE_ACCOUNT_TOKEN" ] to skip an `op read` that otherwise
# hangs on its 5s timeout (no GUI app to answer biometric auth, every shell).
[ -f "$HOME/.config/op/token.sh" ] && . "$HOME/.config/op/token.sh"

# Multi-account `op` wrapper. Lives in zsh.before alongside other early shell
# setup, but we also source it here from zshenv so non-interactive SSH commands like
# `ssh headless-mac 'op --account work vault list'` get the wrapper
# (zshrc / zsh.before only run for interactive shells). The file is pure
# function/export definitions — safe to source twice.
[ -f "$HOME/.dotfiles/shells/zsh/zsh.before/1password.zsh" ] && \
    . "$HOME/.dotfiles/shells/zsh/zsh.before/1password.zsh"

# Add local bin to PATH
export PATH="$HOME/.local/bin:$PATH"

# Add Homebrew to PATH - detect location automatically
if [ -x "$HOME/.homebrew/bin/brew" ]; then
    # User-local Homebrew - also load user-local configuration
    eval "$($HOME/.homebrew/bin/brew shellenv)"
    [ -f "$HOME/.homebrew/homebrew.env" ] && source "$HOME/.homebrew/homebrew.env"
elif [ -x "/opt/homebrew/bin/brew" ]; then
    # Apple Silicon Mac (ARM)
    eval "$(/opt/homebrew/bin/brew shellenv)"
    # Load group configuration if it exists
    [ -f "/opt/homebrew/etc/homebrew.env" ] && source "/opt/homebrew/etc/homebrew.env"
elif [ -x "/usr/local/bin/brew" ]; then
    # Intel Mac
    eval "$(/usr/local/bin/brew shellenv)"
    # Load group configuration if it exists
    [ -f "/usr/local/etc/homebrew.env" ] && source "/usr/local/etc/homebrew.env"
elif command -v brew >/dev/null 2>&1; then
    # Homebrew in PATH
    eval "$(brew shellenv)"
fi

# brew shellenv exports FPATH, so long-lived parents (e.g. the tmux server)
# can hand new shells a stale snapshot after a zsh upgrade removes the old
# keg — breaking every core autoload (compinit, add-zsh-hook,
# up-line-or-beginning-search). Keep the version-independent core-functions
# dir on fpath as a guard; brew relinks it on every zsh upgrade.
if [ -n "${HOMEBREW_PREFIX:-}" ] && [ -d "$HOMEBREW_PREFIX/share/zsh/functions" ]; then
    (( ${fpath[(I)$HOMEBREW_PREFIX/share/zsh/functions]} )) || fpath+=("$HOMEBREW_PREFIX/share/zsh/functions")
fi

# --- asdf 0.16+ ---
# Modern asdf is a Go binary on PATH; no shim source. Just expose its shims dir.
#
# Must be set here rather than in zshrc: zshrc runs for interactive shells only,
# so `ssh mac 'node --version'`, cron, git hooks, and build scripts would all
# fall through to Homebrew's node and silently ignore the repo pin. And it must
# come AFTER the Homebrew block above, because `brew shellenv` *prepends* — set
# earlier, /opt/homebrew/bin/node would still win over the shim.
#
# Drop any inherited copies before prepending. A "skip if already present"
# guard is not enough here: a nested shell inherits PATH with these entries
# present but sitting *behind* Homebrew, and since `brew shellenv` prepends
# again in every shell, each nesting level pushes Homebrew further ahead. Only
# removing and re-prepending actually pins the position. That also makes this
# idempotent — no duplicate entries however many times it runs.
#
# bin/claude-tools goes in front of the shims: the Claude npm CLIs (ccs/claude/
# ccr) must run on the ~/.tool-versions node regardless of repo pins.
#
# Defined as a function because zshenv is not the last word on PATH for login
# shells: /etc/zprofile runs path_helper (which reorders), and our own zprofile
# re-runs `brew shellenv` (which prepends) — both after this file. zprofile
# calls this again afterwards to reassert the order. Same shell process, so the
# function is still in scope there.
_pin_toolchain_path() {
    path=("${(@)path:#$HOME/.asdf/shims}")
    path=("${(@)path:#$DOTFILES/bin/claude-tools}")
    path=("$DOTFILES/bin/claude-tools" "$HOME/.asdf/shims" $path)
    export PATH
}
_pin_toolchain_path

# Set umask for group-writable files (for group-based Homebrew)
# This doesn't hurt for user-local installations
umask 0002

# GitHub PAT for MCP servers (Cursor, Claude Code, etc.)
# Uses 1Password CLI with caching to avoid slowdowns
if command -v op >/dev/null 2>&1 && [ -z "$GITHUB_PERSONAL_ACCESS_TOKEN" ]; then
    # Cache file for the token (valid for current session)
    _gh_token_cache="$HOME/.cache/github_pat_token"
    _gh_token_ttl=3600  # 1 hour cache

    # Check if cache exists and is fresh
    if [ -f "$_gh_token_cache" ] && [ -n "$(find "$_gh_token_cache" -mmin -60 2>/dev/null)" ]; then
        export GITHUB_PERSONAL_ACCESS_TOKEN="$(cat "$_gh_token_cache")"
        export GITHUB_TOKEN="$GITHUB_PERSONAL_ACCESS_TOKEN"
        export GH_TOKEN="$GITHUB_PERSONAL_ACCESS_TOKEN"
    elif [[ -o interactive ]] && [ -z "$OP_SERVICE_ACCOUNT_TOKEN" ] && op account list >/dev/null 2>&1; then
        # Fetch from 1Password and cache. INTERACTIVE SHELLS ONLY.
        # Non-interactive shells (launchd cron, Claude Code's spawned bash, ssh
        # commands) skip this branch entirely: with no GUI to answer the biometric
        # prompt, `op account list`/`op read` stall on the 5s timeout, and because
        # nothing caches the result each of the many shells a headless run spawns
        # pays that 5s again — which is what hung the 7am/9pm pipeline. Non-interactive
        # shells still get a token from the fresh-cache branch above when one exists,
        # and otherwise proceed tokenless (the GitHub PAT is only needed for MCP
        # servers, which the pipeline doesn't invoke).
        # Skipped when running under a service-account token (headless mode):
        # SA tokens are scoped to a single account and cannot resolve
        # cross-account vault refs, which causes `op read` to hang.
        # `timeout 5` is a safety net for biometric prompts that never get answered.
        mkdir -p "$HOME/.cache"
        _token="$(timeout 5 op read --account jbctechsolutions.1password.com "op://Local Dev/GitHub PAT - Claude Code/credential" 2>/dev/null)"
        if [ -n "$_token" ]; then
            echo "$_token" > "$_gh_token_cache"
            chmod 600 "$_gh_token_cache"
            export GITHUB_PERSONAL_ACCESS_TOKEN="$_token"
            export GITHUB_TOKEN="$GITHUB_PERSONAL_ACCESS_TOKEN"
            export GH_TOKEN="$GITHUB_PERSONAL_ACCESS_TOKEN"
        fi
        unset _token
    fi
    unset _gh_token_cache _gh_token_ttl
fi

# Infracost API key — lazy 1Password lookup on first use (JP account).
# No shell-startup cost: the wrapper replaces itself after resolving the key.
# Key lives at op://JP Infrastructure/Infracost API Key/credential (joshuaproject).
if command -v op >/dev/null 2>&1; then
    infracost() {
        if [ -z "$INFRACOST_API_KEY" ]; then
            export INFRACOST_API_KEY="$(op read --account joshuaproject.1password.com "op://JP Infrastructure/Infracost API Key/credential" 2>/dev/null)"
        fi
        unset -f infracost
        command infracost "$@"
    }
fi
