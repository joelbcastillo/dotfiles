# Optimized zshrc for faster startup
# This version uses lazy loading and optimizations to reduce startup time

# Fix for shell integrations that expect dump_zsh_state function
dump_zsh_state() {
    # Dummy function to prevent "command not found" errors
    # This is used by some shell integrations for debugging
    return 0
}

# Set DOTFILES variable
export DOTFILES="$HOME/.dotfiles"

# Path to your oh-my-zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Minimal plugin configuration for faster startup
plugins=(
    git
    brew
    # Removed zsh-autosuggestions and zsh-syntax-highlighting for faster startup
    # These will be loaded lazily later
)

# Disable compinit errors for group owned directories
export ZSH_DISABLE_COMPFIX="true"

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Initialize Starship (fast prompt)
eval "$(starship init zsh)"

# Editor configuration
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='cursor --wait'
fi
export VISUAL="$EDITOR"

# Source essential zsh.before files (fast ones only)
for file in ~/.zsh.before/{1password,aliases,history,key-bindings,noglob,path,rm,zmv,zoxide}.zsh; do
    [[ -f "$file" ]] && source "$file"
done

# asdf 0.16+ is a Go binary on PATH; just expose its shims.
export PATH="$HOME/.asdf/shims:$PATH"

# Lazy load heavy components
# ASDF - load completions on first invocation
asdf() {
    unfunction asdf
    fpath=("${ASDF_DATA_DIR:-$HOME/.asdf}/completions" $fpath)
    autoload -Uz compinit && compinit -C
    command asdf "$@"
}

# Direnv - load only when needed
direnv() {
    unfunction direnv
    eval "$(direnv hook zsh)"
    direnv "$@"
}

# Lazy load completion system
autoload -Uz compinit
# Only run compinit once per day
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

# Lazy load syntax highlighting and autosuggestions
# These will be loaded when the user starts typing
autoload -Uz add-zsh-hook

# Load syntax highlighting on first command
load_syntax_highlighting() {
    if [[ -f "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
        source "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
    fi
    add-zsh-hook -d precmd load_syntax_highlighting
}

# Load autosuggestions on first command
load_autosuggestions() {
    if [[ -f "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
        source "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
    fi
    add-zsh-hook -d precmd load_autosuggestions
}

# Set up lazy loading triggers
add-zsh-hook precmd load_syntax_highlighting
add-zsh-hook precmd load_autosuggestions

# Source custom functions (lightweight)
if [[ -f "$DOTFILES/shells/oh-my-zsh/custom/functions.zsh" ]]; then
    source "$DOTFILES/shells/oh-my-zsh/custom/functions.zsh"
fi

# Source remaining zsh.before files (lazy load the heavy ones)
# These will be loaded when the commands are first used
for file in ~/.zsh.before/{asdf,completion,direnv}.zsh; do
    if [[ -f "$file" ]]; then
        # Create wrapper functions for lazy loading
        case "$(basename "$file" .zsh)" in
            asdf)
                # Already handled above
                ;;
            completion)
                # Completion is already loaded above
                ;;
            direnv)
                # Already handled above
                ;;
        esac
    fi
done

